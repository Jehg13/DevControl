APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=tu-contrasena-de-aplicacion
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ALERT_TO=tu-correo-destino@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Runtime local offline de Nexus. Requiere latest.json y tokenizer.json.
NEXUS_AI_ENABLED=false
NEXUS_AI_DRIVER=local
NEXUS_AI_ENDPOINT=
NEXUS_AI_API_KEY=
NEXUS_AI_MODEL=
NEXUS_AI_TEMPERATURE=0.1
NEXUS_AI_TIMEOUT=30
NEXUS_AI_MAX_STEPS=5
NEXUS_LOCAL_PYTHON=python
NEXUS_LOCAL_SCRIPT=scripts/nexus_infer.py
NEXUS_LOCAL_CHECKPOINT=storage/app/nexus-model/latest.json
NEXUS_LOCAL_TOKENIZER=storage/app/nexus-model/tokenizer.json
NEXUS_LOCAL_MAX_CONTEXT_TOKENS=2048
NEXUS_LOCAL_MAX_NEW_TOKENS=128
NEXUS_LOCAL_TEMPERATURE=0.7
NEXUS_LOCAL_TOP_K=40
NEXUS_LOCAL_TOP_P=0.9
NEXUS_LOCAL_TIMEOUT=30
NEXUS_LOCAL_LOGITS_CACHE_SIZE=1024
NEXUS_LOCAL_QUANTIZATION=none

# Runtime versionado independiente.
NEXUS_RUNTIME_MANIFEST=config/nexus-runtime.json
NEXUS_RUNTIME_VERSION="Nexus AI v0.1"
NEXUS_PROACTIVE_ENABLED=true
NEXUS_PROACTIVE_COOLDOWN_MINUTES=60
NEXUS_PROACTIVE_HIGH_PRIORITY_REPEAT=3
NEXUS_PROACTIVE_MINIMUM_SEVERITY=2

# Seguridad y aprobación externa firmada para datasets de entrenamiento.
NEXUS_SECURITY_MODE=safe
NEXUS_SECURITY_ALLOW_SYSTEM=true
NEXUS_DATASET_APPROVAL_KEY=

# Límites de autonomía.
NEXUS_AUTONOMY_MAX_STEPS=10
NEXUS_AUTONOMY_MAX_RETRIES=2
NEXUS_AUTONOMY_TIMEOUT=300
NEXUS_AUTONOMY_BUDGET=20

# Vigilancia de infraestructura.
NEXUS_INFRASTRUCTURE_TIMEOUT=5
NEXUS_INFRASTRUCTURE_CPU_THRESHOLD=90
NEXUS_INFRASTRUCTURE_MEMORY_THRESHOLD=90
NEXUS_INFRASTRUCTURE_DISK_THRESHOLD=90
NEXUS_INFRASTRUCTURE_SSL_DAYS=30

# Experiencias, optimización y memoria.
NEXUS_EXPERIENCE_MIN_CONFIDENCE=70
NEXUS_EXPERIENCE_MIN_RELEVANCE=60
NEXUS_EXPERIENCE_PLANNER_LIMIT=5
NEXUS_OPTIMIZATION_REPORT_LIMIT=100
NEXUS_OPTIMIZATION_STEP_THRESHOLD=6
NEXUS_MEMORY_RECENT_MESSAGES=8
NEXUS_MEMORY_MESSAGE_CANDIDATES=80
NEXUS_MEMORY_RELEVANT_MESSAGES=6
NEXUS_MEMORY_RELEVANT_MEMORIES=8
NEXUS_MEMORY_AUTOMATIC_MIN_CONFIDENCE=75
NEXUS_MEMORY_DEDUPLICATION_THRESHOLD=0.75

# Ruta absoluta al archivo cacert.pem para las solicitudes HTTPS de GitHub en Windows.
# GITHUB_CA_BUNDLE=C:\ruta\al\cacert.pem
# GITHUB_TOKEN=
GITHUB_IMPORT_MAX_FILES=20
# GIT_BINARY=C:\Program Files\Git\cmd\git.exe
